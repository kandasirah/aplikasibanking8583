@model List<AplikasiBanking8583.Models.Transaction>
@{
    ViewData["Title"] = "Riwayat Transaksi ISO 8583";
    var account = ViewBag.Account as AplikasiBanking8583.Models.Account;
}

<div class="container mt-4">
    @if (account != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Riwayat Transaksi ISO 8583</h2>
                <p class="text-muted mb-0">Rekening: <strong>@account.AccountNumber</strong> - @account.AccountHolderName</p>
            </div>
            <a asp-action="Index" class="btn btn-secondary">Kembali</a>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Tanggal</th>
                            <th>Jenis</th>
                            <th>Jumlah</th>
                            <th>Deskripsi</th>
                            <th>MTI</th>
                            <th>STAN</th>
                            <th>RRN</th>
                            <th>Resp. Code</th>
                            <th>Referensi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var tx in Model)
                            {
                                var amountClass = tx.TransactionType.Contains("Masuk") || tx.TransactionType == "Setor" ? "text-success" : "text-danger";
                                var amountPrefix = tx.TransactionType.Contains("Masuk") || tx.TransactionType == "Setor" ? "+" : "-";
                                var responseClass = tx.ResponseCode == "00" ? "text-success" : "text-danger";
                                <tr>
                                    <td>@tx.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@tx.TransactionType</td>
                                    <td class="@amountClass fw-bold">@amountPrefix Rp @tx.Amount.ToString("N2")</td>
                                    <td>@tx.Description</td>
                                    <td>@tx.MTI</td>
                                    <td>@tx.Stan</td>
                                    <td>@tx.Rrn</td>
                                    <td class="@responseClass fw-bold">@tx.ResponseCode</td>
                                    <td>@tx.Reference</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">Belum ada transaksi.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
