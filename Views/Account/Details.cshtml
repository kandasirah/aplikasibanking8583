@model AplikasiBanking8583.Models.Account

@{
    ViewData["Title"] = "Detail Rekening";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Detail Rekening</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Nomor Rekening</div>
                        <div class="col-md-8">@Model.AccountNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Nama Pemilik</div>
                        <div class="col-md-8">@Model.AccountHolderName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Tipe Rekening</div>
                        <div class="col-md-8">@Model.AccountType</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Saldo</div>
                        <div class="col-md-8 text-success fw-bold">Rp @Model.Balance.ToString("N2")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Tanggal Dibuat</div>
                        <div class="col-md-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="d-grid gap-2 d-md-flex">
                        <a asp-action="BalanceInquiry" asp-route-id="@Model.Id" class="btn btn-info">Cek Saldo</a>
                        <a asp-action="TransactionHistory" asp-route-id="@Model.Id" class="btn btn-dark">Riwayat</a>
                        <a asp-action="Deposit" asp-route-id="@Model.Id" class="btn btn-success">Setor</a>
                        <a asp-action="Withdraw" asp-route-id="@Model.Id" class="btn btn-warning">Tarik</a>
                        <a asp-action="Transfer" asp-route-id="@Model.Id" class="btn btn-primary">Transfer</a>
                        <a asp-action="Index" class="btn btn-secondary">Kembali</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
