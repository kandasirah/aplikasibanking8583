@model List<AplikasiBanking8583.Models.Account>

@{
    ViewData["Title"] = "Daftar Rekening";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Daftar Rekening</h2>
        <a asp-action="Create" class="btn btn-primary">+ Buka Rekening Baru</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>No. Rekening</th>
                            <th>Nama Pemilik</th>
                            <th>Tipe</th>
                            <th>Saldo</th>
                            <th>Tanggal Dibuat</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var account in Model)
                            {
                                <tr>
                                    <td><strong>@account.AccountNumber</strong></td>
                                    <td>@account.AccountHolderName</td>
                                    <td>@account.AccountType</td>
                                    <td class="text-success fw-bold">Rp @account.Balance.ToString("N2")</td>
                                    <td>@account.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@account.Id" class="btn btn-info text-white">Detail</a>
                                            <a asp-action="Deposit" asp-route-id="@account.Id" class="btn btn-success">Setor</a>
                                            <a asp-action="Withdraw" asp-route-id="@account.Id" class="btn btn-warning">Tarik</a>
                                            <a asp-action="Transfer" asp-route-id="@account.Id" class="btn btn-primary">Transfer</a>
                                            <a asp-action="History" asp-route-id="@account.Id" class="btn btn-secondary">Riwayat</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">Belum ada rekening. Silakan buka rekening baru.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
